      "css": ".ds-sheet{background:var(--sheet,#fffefa);color:var(--ink,#172d45);border:1px solid var(--rule,#c9d2ca);border-radius:.8rem;padding:clamp(1.1rem,3vw,2rem);font:16px/1.55 \"Segoe UI\",sans-serif}.ds-sheet h2{margin:0 0 1rem;font:500 clamp(1.6rem,2.6vw,2.1rem)/1.18 Georgia,serif}.ds-sheet p{margin:0}.ds-review{background:#edf2ec}"
