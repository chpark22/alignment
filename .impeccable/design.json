      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Submit the main worksheet action.",
      "html": "<button class=\"ds-btn\">Evaluate draft</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:2.75rem;padding:.55rem 1rem;border:1px solid var(--navy,#17365d);border-radius:.35rem;color:white;background:var(--navy,#17365d);font:700 16px/1.55 \"Segoe UI\",sans-serif;text-decoration:none;cursor:pointer}.ds-btn:hover{background:#244d7a;border-color:#244d7a}.ds-btn:disabled{opacity:.7;cursor:wait}.ds-btn:focus-visible{outline:3px solid var(--focus,#007975);outline-offset:4px}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Support actions such as downloads and saving notes.",
      "html": "<button class=\"ds-btn ds-secondary\">Save notes</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;box-sizing:border-box;min-height:2.75rem;padding:.55rem 1rem;border:1px solid var(--navy,#17365d);border-radius:.35rem;color:white;background:var(--navy,#17365d);font:700 16px/1.55 \"Segoe UI\",sans-serif;text-decoration:none;cursor:pointer}.ds-btn:hover{background:#244d7a;border-color:#244d7a}.ds-btn:disabled{opacity:.7;cursor:wait}.ds-btn:focus-visible{outline:3px solid var(--focus,#007975);outline-offset:4px}.ds-secondary{background:transparent;color:var(--navy,#17365d)}.ds-secondary:hover{background:var(--wash,#e8efea)}"
    },
    {
      "name": "Draft field",
      "kind": "input",
      "refersTo": "field",
      "description": "A labeled, vertically resizable field.",
      "html": "<label class=\"ds-label\" for=\"ds-draft\">Your draft</label><textarea class=\"ds-field\" id=\"ds-draft\" rows=\"3\" placeholder=\"Enter your draft\"></textarea>",
      "css": ".ds-label{display:block;margin:.9rem 0 .3rem;color:var(--ink,#172d45);font:650 16px/1.55 \"Segoe UI\",sans-serif}.ds-field{box-sizing:border-box;display:block;width:100%;resize:vertical;padding:.55rem .7rem;color:var(--ink,#172d45);background:var(--sheet,#fffefa);border:1px solid #83958a;border-radius:.35rem;font:16px/1.55 \"Segoe UI\",sans-serif;caret-color:var(--teal,#216b68)}.ds-field::placeholder{color:var(--muted,#4b6171)}.ds-field:focus-visible{outline:3px solid var(--focus,#007975);outline-offset:4px}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "description": "Underline the current destination.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#overview\">Overview</a><a href=\"#coach\" aria-current=\"page\">Message Coach</a><a href=\"#diagnostic\">Team Diagnostic</a></nav>",
      "css": ".ds-nav{display:flex;flex-wrap:wrap;gap:.3rem 1.5rem;font:16px/1.55 \"Segoe UI\",sans-serif}.ds-nav a{padding:.75rem 0;color:var(--muted,#4b6171);text-decoration:none;border-bottom:2px solid transparent}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--teal,#216b68);border-color:var(--teal,#216b68)}.ds-nav a:focus-visible{outline:3px solid var(--focus,#007975);outline-offset:4px}"
    },
    {
      "name": "Worksheet panel",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Hold the source draft or survey findings.",
      "html": "<section class=\"ds-sheet\"><h2>Your draft</h2><p>Write the message you plan to share.</p></section>",
      "css": ".ds-sheet{background:var(--sheet,#fffefa);color:var(--ink,#172d45);border:1px solid var(--rule,#c9d2ca);border-radius:.8rem;padding:clamp(1.1rem,3vw,2rem);font:16px/1.55 \"Segoe UI\",sans-serif}.ds-sheet h2{margin:0 0 1rem;font:500 clamp(1.6rem,2.6vw,2.1rem)/1.18 Georgia,serif}.ds-sheet p{margin:0}"
    },
